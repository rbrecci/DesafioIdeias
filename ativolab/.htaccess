# AtivoLab - raiz publica (conteudo de htdocs)

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # arquivos e pastas reais (assets, uploads) sao servidos direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # todo o resto vai para o front controller
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Rede de seguranca: se o rewrite falhar, estes arquivos nao vazam
<FilesMatch "\.(sql|md|log|ini|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
