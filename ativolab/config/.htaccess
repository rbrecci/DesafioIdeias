# Pasta interna: nada aqui pode ser acessado pelo navegador.
#
# Escrito para funcionar tanto em Apache 2.4 quanto em 2.2. Sem os guardas
# <IfModule>, uma diretiva desconhecida derruba a pasta inteira com erro 500
# em vez de proteger - falha silenciosa que so aparece em producao.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
